# =============================================================================
# SecureDocs — Environment Variables
# =============================================================================
# Copy this file to .env and update the values as needed.
# =============================================================================

# MongoDB connection string
# For local development:         mongodb://localhost:27017/securedocs
# For Docker (containers):       mongodb://mongodb:27017/securedocs  (set automatically in docker-compose)
MONGODB_URI=mongodb://localhost:27017/securedocs

# API server port
PORT=5001

# JWT secret for authentication tokens (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=securedocs-dev-secret-change-in-production

# Firebase (optional — for document storage)
# FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
