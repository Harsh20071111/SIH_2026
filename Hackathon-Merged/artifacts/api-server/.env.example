# SecureDocs API Server — Environment Variables

PORT=5001
MONGODB_URI=mongodb://localhost:27017/securedocs
JWT_SECRET=securedocs-dev-secret-change-in-production

# Firebase Storage (optional for local dev — falls back to local ./uploads/)
FIREBASE_STORAGE_BUCKET=your-bucket.appspot.com
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
